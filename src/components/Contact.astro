---
import { contact } from '../data/contact';
import type { Dictionary } from '../i18n';
import Icons from './icons/Icons.astro';

type Props = {
  t: Dictionary['contact'];
};

const { t } = Astro.props;

const items = [
  {
    icon: 'mail' as const,
    label: t.email,
    value: contact.email,
    href: `mailto:${contact.email}`,
    external: false,
  },
  {
    icon: 'phone' as const,
    label: t.phone,
    value: contact.phoneDisplay,
    href: `tel:${contact.phoneTel}`,
    external: false,
  },
  {
    icon: 'whatsapp' as const,
    label: t.whatsapp,
    value: contact.whatsappDisplay,
    href: contact.whatsappUrl,
    external: true,
  },
  {
    icon: 'map' as const,
    label: t.address,
    value: `${contact.address.line1}\n${contact.address.line2}\nCEP ${contact.address.cep}`,
    href: contact.address.mapsUrl,
    external: true,
  },
];
---

<section id="contato" class="scroll-mt-24 border-t border-border py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl tracking-tight text-ink md:text-4xl">{t.title}</h2>
      <p class="mt-3 text-ink-muted">{t.subtitle}</p>
    </div>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex h-full flex-col rounded-2xl border border-border bg-surface-elevated/70 p-6 transition hover:border-accent"
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-accent-soft text-accent">
                <Icons name={item.icon} class="h-5 w-5" />
              </span>
              <span class="mt-4 text-sm font-medium uppercase tracking-wide text-ink-muted">{item.label}</span>
              <span class="mt-1 whitespace-pre-line text-base font-semibold leading-snug text-ink">{item.value}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
