---
import { localePath, type Locale, type Dictionary } from '../i18n';

type Props = {
  locale: Locale;
  labels: Dictionary['lang'];
};

const { locale, labels } = Astro.props;

const options: Array<{ code: Locale; label: string }> = [
  { code: 'pt-br', label: 'PT' },
  { code: 'en', label: 'EN' },
  { code: 'es', label: 'ES' },
];
---

<div class="relative" data-lang-switch>
  <label class="sr-only" for="lang-select">{labels.label}</label>
  <select
    id="lang-select"
    class="h-10 appearance-none rounded-full border border-border bg-surface-elevated px-3 pr-8 text-sm font-medium text-ink transition hover:border-accent"
    aria-label={labels.label}
  >
    {
      options.map((option) => (
        <option value={localePath(option.code)} selected={option.code === locale}>
          {option.label}
        </option>
      ))
    }
  </select>
  <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-ink-muted" aria-hidden="true">▾</span>
</div>

<script>
  const select = document.getElementById('lang-select');
  select?.addEventListener('change', (event) => {
    const target = event.target;
    if (target instanceof HTMLSelectElement) {
      window.location.href = target.value;
    }
  });
</script>
