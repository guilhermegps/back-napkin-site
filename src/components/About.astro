---
import { media } from '../data/media';
import type { Dictionary } from '../i18n';

type Props = {
  t: Dictionary['about'];
};

const { t } = Astro.props;
---

<section id="sobre" class="scroll-mt-24 border-t border-border py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 md:grid-cols-[0.95fr_1.05fr] md:items-start md:gap-14 md:px-8">
    <div class="space-y-4">
      <div class="overflow-hidden rounded-[1.75rem] border border-border">
        <img
          src={media.about}
          alt={t.imageAlt}
          width="1600"
          height="1067"
          class="aspect-[4/3] h-full w-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="overflow-hidden rounded-[1.75rem] border border-border">
        <img
          src={media.aboutSecondary}
          alt=""
          width="1600"
          height="1067"
          class="aspect-[21/9] w-full object-cover"
          loading="lazy"
        />
      </div>
    </div>

    <div>
      <h2 class="font-display text-3xl tracking-tight text-ink md:text-4xl">{t.title}</h2>
      <p class="mt-4 font-display text-xl text-accent md:text-2xl">{t.subtitle}</p>
      <p class="mt-3 text-sm font-semibold uppercase tracking-wide text-ink-muted">
        {t.role}
      </p>
      <div class="mt-6 space-y-5 text-base leading-relaxed text-ink-muted md:text-lg">
        {t.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>
</section>
