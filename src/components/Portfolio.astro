---
import type { Dictionary } from '../i18n';

type Props = {
  t: Dictionary['portfolio'];
};

const { t } = Astro.props;
---

<section id="portfolio" class="scroll-mt-24 border-t border-border py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl tracking-tight text-ink md:text-4xl">{t.title}</h2>
      <p class="mt-3 text-ink-muted">{t.subtitle}</p>
    </div>

    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {
        t.cases.map((item) => (
          <li class="flex flex-col overflow-hidden rounded-2xl border border-border bg-surface-elevated/70">
            <div class="relative aspect-[16/10] bg-[linear-gradient(135deg,var(--accent-soft),transparent_55%),linear-gradient(160deg,#1a2420,var(--surface))]">
              <div class="absolute inset-0 opacity-40" style="background-image: radial-gradient(circle at 20% 30%, var(--accent), transparent 28%), radial-gradient(circle at 80% 70%, rgba(90,140,120,0.5), transparent 32%);"></div>
              <span class="absolute bottom-4 left-4 rounded-full bg-surface/80 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-accent backdrop-blur">
                {item.tag}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="font-display text-xl text-ink">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">{item.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
