---
import { media } from '../data/media';
import type { Dictionary, Locale } from '../i18n';
import { localePath } from '../i18n';
import Icons from './icons/Icons.astro';

type Props = {
  locale: Locale;
  t: Dictionary['hero'];
};

const { locale, t } = Astro.props;
const home = localePath(locale);
---

<section class="relative overflow-hidden">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 pb-20 pt-14 md:grid-cols-[1.05fr_0.95fr] md:items-stretch md:gap-12 md:px-8 md:pb-28 md:pt-20">
    <div class="flex flex-col justify-center">
      <p class="animate-fade font-display text-4xl tracking-tight text-ink sm:text-5xl md:text-6xl lg:text-7xl">
        {t.brand}
      </p>
      <div class="animate-draw mt-5 h-px w-28 bg-accent"></div>
      <h1 class="animate-rise mt-6 max-w-xl font-display text-2xl leading-tight text-ink sm:text-3xl md:text-4xl" style="animation-delay: 0.1s">
        {t.headline}
      </h1>
      <p class="animate-rise mt-5 max-w-xl text-base leading-relaxed text-ink-muted md:text-lg" style="animation-delay: 0.2s">
        {t.subtitle}
      </p>
      <div class="animate-rise mt-8 flex flex-wrap gap-3" style="animation-delay: 0.3s">
        <a
          href={`${home}#contato`}
          class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-3 text-sm font-semibold text-accent-ink transition hover:brightness-110"
        >
          {t.ctaPrimary}
          <Icons name="arrow" class="h-4 w-4" />
        </a>
        <a
          href={`${home}#servicos`}
          class="inline-flex items-center rounded-full border border-border bg-surface-elevated px-5 py-3 text-sm font-semibold text-ink transition hover:border-accent"
        >
          {t.ctaSecondary}
        </a>
      </div>
    </div>

    <div class="animate-rise relative min-h-[280px] overflow-hidden rounded-[2rem] border border-border md:min-h-[420px]" style="animation-delay: 0.15s">
      <img
        src={media.hero}
        alt=""
        width="1920"
        height="1280"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[rgba(13,17,16,0.72)] via-[rgba(13,17,16,0.18)] to-transparent"></div>
      <div class="absolute bottom-5 left-5 right-5 flex items-center gap-3 rounded-2xl border border-border/60 bg-surface/70 px-4 py-3 backdrop-blur-md">
        <img
          src={media.logo}
          alt=""
          width="40"
          height="40"
          class="h-10 w-10 rounded-md object-cover"
        />
        <p class="text-sm font-medium text-ink">sketch → ship</p>
      </div>
    </div>
  </div>
</section>
