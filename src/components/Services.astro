---
import type { Dictionary } from '../i18n';
import Icons from './icons/Icons.astro';

type Props = {
  t: Dictionary['services'];
};

const { t } = Astro.props;
const icons = ['code', 'compass', 'layers', 'workflow'] as const;
---

<section id="servicos" class="scroll-mt-24 border-t border-border py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl tracking-tight text-ink md:text-4xl">{t.title}</h2>
      <p class="mt-3 text-ink-muted">{t.subtitle}</p>
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2">
      {
        t.items.map((item, index) => (
          <li class="rounded-2xl border border-border bg-surface-elevated/70 p-6 transition hover:border-accent/50">
            <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-full bg-accent-soft text-accent">
              <Icons name={icons[index] ?? 'code'} class="h-5 w-5" />
            </div>
            <h3 class="font-display text-xl text-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted md:text-base">{item.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
